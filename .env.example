#Database (local Docker dev only)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=homemenu
DB_USER=homemenu
DB_PASSWORD=
# Local Docker only: password for the dev database's root user (not used in production)
DB_ROOT_PASSWORD=


# Production only: a database user with CREATE/ALTER/DROP, used by `npm run migrate`.
# Locally these can stay empty; the migrate script falls back to DB_USER/DB_PASSWORD.
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=